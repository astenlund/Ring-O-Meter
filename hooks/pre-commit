#!/usr/bin/env bash

# Auto-fix formatting on staged C# and TS/JS files. Unfixable issues block.
# Setup: git config core.hooksPath hooks  (one time per clone)
# A local core.hooksPath replaces a user- or system-level one rather than adding to it, so this hook then runs that directory's pre-commit itself, after its own checks, and fails if it fails.

set -e

# Resolve repo root so the hook works regardless of the cwd git invokes it from (commits made from a subdirectory must still find the .slnx and the staged files, which git emits as repo-root-relative paths).
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Reads the NUL-separated paths a command prints into the PATHS array, so every path reaches the tools below as one argument, unquoted and unsplit.
# The command appends an empty record only when it succeeds, and git never prints an empty path, so a failing command blocks the commit rather than reading as an empty list.
read_paths() {
    local path complete=false
    PATHS=()
    while IFS= read -r -d '' path; do
        if [ -z "$path" ]; then
            complete=true
            break
        fi
        PATHS+=("$path")
    done < <("$@" && printf '\0')
    if ! $complete; then
        echo "pre-commit: could not list files with: $*" >&2
        exit 1
    fi
}

read_paths git diff --cached -z --name-only --diff-filter=ACM -- '*.cs'
STAGED_CS=("${PATHS[@]}")
read_paths git diff --cached -z --name-only --diff-filter=ACM -- 'web/**/*.ts' 'web/**/*.tsx' 'web/**/*.js'
STAGED_JS=("${PATHS[@]}")

# Each tool is probed once, so the partial-stage guard and the fix step for a file kind always agree on whether that kind gets rewritten.
HAVE_DOTNET=false
HAVE_PNPM=false
if command -v dotnet >/dev/null 2>&1; then
    HAVE_DOTNET=true
fi
if command -v pnpm >/dev/null 2>&1; then
    HAVE_PNPM=true
fi

# The fix steps below re-add each whole file, so a file with unstaged changes would have them committed without notice; refuse such files up front.
# Only file kinds the hook will actually rewrite are checked: C# when dotnet is available, web files when pnpm is.
# The staged paths are passed as literal pathspecs, so no path is read as a glob or other pathspec magic.
PARTIAL=()
if [ ${#STAGED_CS[@]} -gt 0 ] && $HAVE_DOTNET; then
    read_paths git --literal-pathspecs diff -z --name-only -- "${STAGED_CS[@]}"
    PARTIAL+=("${PATHS[@]}")
fi
if [ ${#STAGED_JS[@]} -gt 0 ] && $HAVE_PNPM; then
    read_paths git --literal-pathspecs diff -z --name-only -- "${STAGED_JS[@]}"
    PARTIAL+=("${PATHS[@]}")
fi
if [ ${#PARTIAL[@]} -gt 0 ]; then
    echo "pre-commit: these files have unstaged changes that the auto-fix would commit along with the staged ones:" >&2
    printf '  %s\n' "${PARTIAL[@]}" >&2
    echo "Stage or stash the rest of each file, then commit again." >&2
    exit 1
fi

if [ ${#STAGED_CS[@]} -gt 0 ]; then
    if ! $HAVE_DOTNET; then
        echo "warning: dotnet not found, skipping C# format"
    else
        dotnet format Ring-O-Meter.slnx --include "${STAGED_CS[@]}"
        git --literal-pathspecs add -- "${STAGED_CS[@]}"

        # Final check that format actually settled (verify-no-changes will exit non-zero if there is anything still off)
        dotnet format Ring-O-Meter.slnx --verify-no-changes --include "${STAGED_CS[@]}"
    fi
fi

if [ ${#STAGED_JS[@]} -gt 0 ]; then
    if ! $HAVE_PNPM; then
        echo "warning: pnpm not found, skipping JS lint (install pnpm to enable)"
    else
        # Staged paths come back repo-root-relative (e.g. web/src/foo.ts); strip the web/ prefix so they resolve when eslint runs with cwd=web.
        STAGED_JS_REL=("${STAGED_JS[@]#web/}")

        (cd web && pnpm exec eslint --fix "${STAGED_JS_REL[@]}")
        git --literal-pathspecs add -- "${STAGED_JS[@]}"

        # Final check fails on unfixable
        (cd web && pnpm exec eslint "${STAGED_JS_REL[@]}")

        # Type-check the projects web/tsconfig.json references (src/, every .ts at the web/ root, and web/e2e) so type errors block the commit.
        # web/tsconfig.json is solution-style (no files, only project references), so only build mode checks anything.
        (cd web && pnpm exec tsc -b)
    fi
fi

# Chain to the pre-commit of the hooks directory configured outside this clone, last, so it sees the final staged content.
# --includes is needed because a scoped lookup otherwise ignores [include] directives, where a user-level hooksPath often lives.
# --type=path applies Git's own pathname expansion (~, ~user/, %(prefix)/), so this resolves the directory Git itself would use.
# git config --get exits 1 only when the key is absent; any other status means the lookup failed, which blocks the commit rather than skipping the chain.
PREVIOUS_HOOKS=
for SCOPE in --global --system; do
    STATUS=0
    PREVIOUS_HOOKS=$(git config "$SCOPE" --includes --type=path --get core.hooksPath) || STATUS=$?
    if [ "$STATUS" -eq 0 ]; then
        break
    fi
    if [ "$STATUS" -ne 1 ]; then
        echo "pre-commit: could not read $SCOPE core.hooksPath (git config exited $STATUS)" >&2
        exit 1
    fi
    PREVIOUS_HOOKS=
done

# RINGOMETER_PRECOMMIT_CHAINED marks a run this chain started, so a configured directory holding another checkout's copy of this hook cannot recurse.
if [ -z "${RINGOMETER_PRECOMMIT_CHAINED:-}" ] && [ -n "$PREVIOUS_HOOKS" ] && [ -x "$PREVIOUS_HOOKS/pre-commit" ]; then
    PREVIOUS_DIR=$(cd "$PREVIOUS_HOOKS" && pwd -P)
    OWN_DIR=$(cd "$REPO_ROOT/hooks" && pwd -P)
    if [ "$PREVIOUS_DIR" != "$OWN_DIR" ]; then
        RINGOMETER_PRECOMMIT_CHAINED=1 "$PREVIOUS_DIR/pre-commit"
    fi
fi

exit 0
